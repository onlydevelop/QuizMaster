<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuizMaster" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorPrimaryDark">@android:color/white</item>
        <item name="colorAccent">@color/colorViolet</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/colorViolet</item>
        <item name="android:buttonStyle">@style/Widget.QuizMaster.Button</item>
        <item name="buttonStyle">@style/Widget.QuizMaster.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.QuizMaster.Dialog</item>
        <item name="android:alertDialogTheme" tools:targetApi="lollipop">@style/ThemeOverlay.QuizMaster.Dialog</item>
    </style>

    <style name="Widget.QuizMaster.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/button_background</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.QuizMaster.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorViolet</item>
        <item name="colorAccent">@color/colorViolet</item>
        <item name="android:textColorPrimary">@color/colorViolet</item>
    </style>
</resources>
